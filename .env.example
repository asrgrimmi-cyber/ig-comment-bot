# ---- copy to .env and fill in (never commit .env) ----
PORT=8091
# From Meta app dashboard -> App settings -> Basic -> App secret (Instagram app secret if using Instagram Login)
IG_APP_SECRET=
# Any random string; paste the SAME string into Meta's webhook "Verify token" box
IG_VERIFY_TOKEN=
# Long-lived Instagram User access token (Instagram API with Instagram Login). Auto-refreshed every 7 days.
IG_ACCESS_TOKEN=
# Your Instagram professional account ID (Meta dashboard shows it next to the generated token)
IG_USER_ID=

# Comment keywords (comma separated, whole-word, case-insensitive)
KEYWORDS=board
# Only these post/reel media IDs (comma separated). Empty = all your posts.
MEDIA_IDS=
LINK=https://asrgrimmi-cyber.github.io/next-stop/?src=ig-reel1
# {name} = commenter's username, {link} = LINK, \n = new line
DM_TEXT=Hey {name}! 👋 Here's Next Stop, the to-do list that works like a departures board:\n{link}\n\nCheck in, book your first flight (only the name is needed), and tap "Report a problem" if anything breaks 🙏
PUBLIC_REPLY=1
PUBLIC_REPLIES=Sent you the link 📩 check your DMs (or Message requests)!|Link's in your DMs ✈️|Check your DMs 🙌 boarding pass sent!

# Optional: log each DM to the Next Stop tester Google Sheet (Events tab)
SHEET_LOG_URL=
SHEET_LOG_KEY=nextstop-testers
# Key for GET /ig/stats?key=...
ADMIN_KEY=
# 1 = log only, never call Instagram (and accept unsigned test events)
DRY_RUN=0
